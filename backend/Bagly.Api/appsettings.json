{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=BaglyDb;User ID=YOUR_ADMIN;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Key": "SET_VIA_ENV_Jwt__Key_min_32_chars________________",
    "Issuer": "Bagly.Api",
    "Audience": "Bagly.Frontend",
    "ExpiresMinutes": 480
  },
  "Admin": {
    "Email": "admin@bagly.store",
    "Password": "SET_VIA_ENV_Admin__Password",
    "Name": "Bagly Admin"
  },
  "Email": {
    "Enabled": true,
    "Provider": "Smtp",
    "Host": "SET_VIA_ENV_Email__Host",
    "Port": 587,
    "Username": "SET_VIA_ENV_Email__Username",
    "Password": "SET_VIA_ENV_Email__Password",
    "SendGridApiKey": "SET_VIA_ENV_Email__SendGridApiKey",
    "FromAddress": "noreply@bagly.store",
    "FromName": "Bagly",
    "UseSsl": true
  },
  "Razorpay": {
    "KeyId": "SET_VIA_ENV_Razorpay__KeyId",
    "KeySecret": "SET_VIA_ENV_Razorpay__KeySecret",
    "Currency": "INR",
    "UsdToInrRate": 83
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
